diff --git a/src/runtime/runtime_scalar.h b/src/runtime/runtime_scalar.h
new file mode 100644
--- /dev/null
+++ b/src/runtime/runtime_scalar.h
@@ -0,0 +1,70 @@
+/* Goose Embedded scalar-v0 runtime, ABI 1. Apache-2.0 (Goose root LICENSE).
+   The checked i32 helpers retain runtime.h's widened narrow-integer rules.
+   No data stacks, allocator, OS services, or recoverable panic mechanism. */
+#ifndef GE_SCALAR_V0_RUNTIME_H
+#define GE_SCALAR_V0_RUNTIME_H
+
+#include <stdint.h>
+#include <stddef.h>
+#include <limits.h>
+
+#if !defined(GS_SCALAR_V0_VALIDATED) || GS_SCALAR_V0_VALIDATED != 1
+#error "scalar runtime requires compiler validation revision 1"
+#endif
+#if !defined(GS_DEBUG) || GS_DEBUG != 1
+#error "scalar runtime requires checked arithmetic"
+#endif
+#if defined(GE_SCALAR_V0_ABI_VERSION) && GE_SCALAR_V0_ABI_VERSION != 1
+#error "incompatible scalar runtime ABI"
+#endif
+#define GE_SCALAR_V0_ABI_VERSION 1
+_Static_assert(CHAR_BIT == 8 && sizeof(int32_t) == 4, "scalar-v0 requires 8-bit bytes and i32");
+
+#if defined(__GNUC__) || defined(__clang__)
+#define GS_ALIGN1 __attribute__((aligned(1)))
+#define GS_NORETURN __attribute__((noreturn))
+#define GS_NOINLINE __attribute__((noinline))
+#define GS_INLINE __attribute__((always_inline)) inline
+#elif defined(_MSC_VER)
+#define GS_ALIGN1
+#define GS_NORETURN __declspec(noreturn)
+#define GS_NOINLINE __declspec(noinline)
+#define GS_INLINE __forceinline
+#else
+#error "scalar-v0 requires a supported noreturn/alignment convention"
+#endif
+typedef int32_t gs_i32 GS_ALIGN1;
+
+/* Supplied by the platform. Message/file are borrowed static strings (file may
+   be NULL for lifecycle errors); the hook must never return or allocate. */
+GS_NORETURN void ge_scalar_v0_panic_v1(const char *message, const char *file, int line);
+#define GS_UNREACHABLE(file, line) \
+    ge_scalar_v0_panic_v1("unreachable scalar code", (file), (line))
+
+static GS_NORETURN void gs_panic(const char *message) {
+    ge_scalar_v0_panic_v1(message, NULL, 0);
+}
+static GS_NORETURN void gs_scalar_overflow(const char *file, int line) {
+    ge_scalar_v0_panic_v1("i32 overflow", file, line);
+}
+static int32_t gs_add_i32(int32_t a, int32_t b, const char *file, int line) {
+    int64_t r = (int64_t)a + (int64_t)b;
+    if (r < INT32_MIN || r > INT32_MAX) gs_scalar_overflow(file, line);
+    return (int32_t)r;
+}
+static int32_t gs_sub_i32(int32_t a, int32_t b, const char *file, int line) {
+    int64_t r = (int64_t)a - (int64_t)b;
+    if (r < INT32_MIN || r > INT32_MAX) gs_scalar_overflow(file, line);
+    return (int32_t)r;
+}
+static int32_t gs_mul_i32(int32_t a, int32_t b, const char *file, int line) {
+    int64_t r = (int64_t)a * (int64_t)b;
+    if (r < INT32_MIN || r > INT32_MAX) gs_scalar_overflow(file, line);
+    return (int32_t)r;
+}
+static int32_t gs_neg_i32(int32_t a, const char *file, int line) {
+    int64_t r = -(int64_t)a;
+    if (r < INT32_MIN || r > INT32_MAX) gs_scalar_overflow(file, line);
+    return (int32_t)r;
+}
+#endif
