diff --git a/src/scalar_profile.h b/src/scalar_profile.h
new file mode 100644
index 0000000..ffbefac
--- /dev/null
+++ b/src/scalar_profile.h
@@ -0,0 +1,171 @@
+// Goose Embedded modification, 2026-11-04: opt-in scalar-v0 validation.
+// Original project code; desktop runtime selection is deliberately unchanged.
+#pragma once
+
+namespace goose {
+
+struct ScalarV0 {
+    Ast &ast;
+    map<string_view, SFunction *> functions;
+    map<SFunction *, vector<SFunction *>> calls;
+
+    [[noreturn]] void Fail(Line line, const string &message) {
+        Diagnostic d;
+        d.where = LocOf(line);
+        d.message = "scalar-v0: " + message;
+        d.text = ast.DiagnosticText(d, true);
+        throw CompileError { d.text, { d } };
+    }
+    bool Scalar(TypeExpr *t, bool boolean = true) {
+        return t && !t->cq && !t->ix && !t->aliasuse &&
+               ((t->kind == TY_INT && t->intstorage == IS_I32) ||
+                (boolean && t->kind == TY_BOOL));
+    }
+    void Type(TypeExpr *t, Line line, bool boolean = true) {
+        if (!Scalar(t, boolean)) Fail(line, boolean ? "expected plain i32 or bool type"
+                                                                  : "function ABI requires plain i32");
+    }
+    void Walk(Node *n, SFunction *owner, bool typed, bool min_magnitude = false) {
+        if (!n) return;
+        bool literal = false;
+        switch (n->nkind) {
+            case NK_IntLit: {
+                auto i = Is<IntLit>(n);
+                if (i->uns || i->val < INT32_MIN ||
+                    i->val > (int64_t)INT32_MAX + (min_magnitude ? 1 : 0))
+                    Fail(n->line, "integer literal is outside i32");
+                if (i->fixedtype) Type(i->fixedtype, n->line, false);
+                literal = true;  // Adaptable literals have an upstream i64 annotation.
+                break;
+            }
+            case NK_BoolLit: break;
+            case NK_Ident:
+                if (typed) {
+                    auto i = Is<Ident>(n);
+                    if (!i->vdef || i->vdef->isglobal || i->fnref)
+                        Fail(n->line, "only local scalar value identifiers are supported");
+                    Type(i->vdef->type, n->line);
+                }
+                break;
+            case NK_Unary: {
+                auto u = Is<Unary>(n);
+                if (u->op != T_MINUS && u->op != T_NOT)
+                    Fail(n->line, "unsupported unary operator");
+                if (u->op == T_MINUS && Is<IntLit>(u->child)) {
+                    Walk(u->child, owner, typed, true);
+                    // A negative adaptable literal is compile-time data, not i64 storage.
+                    return;
+                }
+                break;
+            }
+            case NK_Binary: {
+                auto op = Is<Binary>(n)->op;
+                if (op != T_PLUS && op != T_MINUS && op != T_MUL && op != T_EQ &&
+                    op != T_NEQ && op != T_LT && op != T_GT && op != T_LTEQ &&
+                    op != T_GTEQ && op != T_ANDAND && op != T_OROR)
+                    Fail(n->line, "unsupported binary operator");
+                break;
+            }
+            case NK_Block: break;
+            case NK_IfExpr: break;
+            case NK_Return: {
+                auto r = Is<Return>(n);
+                if (!r->from.empty() || r->vals.size() != 1)
+                    Fail(n->line, "only ordinary single-value returns are supported");
+                if (typed && r->target != owner) Fail(n->line, "nonlocal return is unsupported");
+                break;
+            }
+            case NK_VarDecl: {
+                auto v = Is<VarDecl>(n);
+                if (v->isglobal || v->isconst || v->reusable || v->byref || v->results ||
+                    v->names.size() != 1 || v->inits.size() != 1)
+                    Fail(n->line, "only initialized single scalar locals are supported");
+                if (v->type) Type(v->type, n->line);
+                if (typed) {
+                    if (v->defs.size() != 1) Fail(n->line, "missing checked local");
+                    Type(v->defs[0]->type, n->line);
+                }
+                break;
+            }
+            case NK_Assign: {
+                auto a = Is<Assign>(n);
+                if (a->op != T_ASSIGN || !Is<Ident>(a->lval) || a->pointee)
+                    Fail(n->line, "only ordinary local assignment is supported");
+                break;
+            }
+            case NK_Call: {
+                auto c = Is<Call>(n);
+                auto id = Is<Ident>(c->callee);
+                if (!id || !c->tyargs.empty() || c->trailing || !functions.count(id->name))
+                    Fail(n->line, "only direct calls to admitted scalar functions are supported");
+                auto target = functions.at(id->name);
+                if (typed && (!c->spec || c->spec->sf != target || c->builtin >= 0 ||
+                              !c->dispatch.empty() || c->fvbody || c->defaultinit || c->ndefaults))
+                    Fail(n->line, "unsupported checked call resolution");
+                if (!typed) calls[owner].push_back(target);
+                if (typed) Type(n->exprtype, n->line, false);
+                // The callee identifier denotes a function, not stored user data.
+                for (auto arg : c->args) Walk(arg, owner, typed);
+                return;
+            }
+            default: Fail(n->line, "unsupported AST construct");
+        }
+        if (typed && !literal && n->exprtype && n->exprtype->kind != TY_VOID)
+            Type(n->exprtype, n->line);
+        // Statements may have no exprtype; value-producing leaves may not.
+        if (typed && !literal && (Is<Ident>(n) || Is<Unary>(n) || Is<Binary>(n) ||
+                                Is<BoolLit>(n)) && !n->exprtype)
+            Fail(n->line, "missing checked scalar expression");
+        n->Children([&](Node *child) { Walk(child, owner, typed); });
+    }
+    void Source() {
+        for (auto n : ast.topdecls) {
+            auto f = Is<FnDecl>(n);
+            if (!f) Fail(n->line, "only top-level scalar function declarations are supported");
+            auto sf = f->sf;
+            if (!sf->ns.empty() || sf->name == "main" || sf->IsGeneric() || sf->isrec ||
+                sf->isinline || sf->issimd || sf->checkfree || sf->isthread || sf->isextern ||
+                sf->isnested || sf->outer || !sf->body || !sf->dylib.empty() ||
+                sf->readsalltops || sf->takesloc)
+                Fail(sf->line, "unsupported function form or modifier");
+            if (!functions.emplace(sf->name, sf).second)
+                Fail(sf->line, "function overloading is unsupported");
+            if (!sf->has_rets || sf->rets.size() != 1)
+                Fail(sf->line, "explicit single i32 result is required");
+            Type(sf->rets[0], sf->line, false);
+            for (auto &param : sf->params) {
+                Type(param.type, param.line, false);
+                if (param.defaultval) Fail(param.line, "default arguments are unsupported");
+            }
+        }
+        bool exported = false;
+        for (auto &[name, sf] : functions) {
+            exported |= sf->isexport;
+            Walk(sf->body, sf, false);
+        }
+        if (!exported) Fail(Line {}, "at least one scalar export is required");
+        map<SFunction *, int> state;
+        function<void(SFunction *)> visit = [&](SFunction *sf) {
+            if (state[sf] == 1) Fail(sf->line, "recursive call graph is unsupported");
+            if (state[sf] == 2) return;
+            state[sf] = 1;
+            for (auto target : calls[sf]) visit(target);
+            state[sf] = 2;
+        };
+        for (auto &[name, sf] : functions) visit(sf);
+    }
+    void Checked() {
+        for (auto &[name, sf] : functions) {
+            if (sf->specs.empty()) Fail(sf->line, "function has no checked specialization");
+            for (auto sp : sf->specs) {
+                if (sp->incycle || sp->failed || sp->isfunval || sp->rets.size() != 1)
+                    Fail(sf->line, "unsupported checked specialization");
+                Type(sp->rets[0], sf->line, false);
+                for (auto t : sp->argtypes) Type(t, sf->line, false);
+                Walk(sp->body, sf, true);
+            }
+        }
+    }
+};
+
+} // namespace goose
